{
  "name": "self-directed-learning",
  "version": "1.1.1",
  "description": "自我导向学习辅助器 —— 把目标变成可验证的学习结构（知识地图 / 路径 / 资源 / 验收 / 复盘）",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "JJS-Sudo",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "bin": {
    "sdl": "bin/sdl.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "snapshot": "node scripts/public-snapshot.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dev:api": "cross-env PORT=3001 tsx watch src/index.ts",
    "dev:web": "vite",
    "reset": "tsx src/tools/reset.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p tsconfig.electron.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop:dev": "npm run build && npm run build:electron && electron .",
    "desktop:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "desktop:dist": "npm run build && npm run build:electron && electron-builder --publish never",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "maps": "tsx src/tools/maps.ts",
    "index": "tsx src/tools/index.ts",
    "migrate": "tsx src/tools/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.8.11",
    "gray-matter": "^4.0.3",
    "hono": "4.13.11",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.2"
  }
}
