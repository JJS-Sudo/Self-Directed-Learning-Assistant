# 复制为 .env 后填写；不要把真实 key 提交进 git
# cp .env.example .env

# 模型与搜索（不填则对应功能不可用，页面会给出提示）
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# 监听地址：默认只绑本机；改成 0.0.0.0 前必须先设 SDL_ACCESS_TOKEN
HOST=127.0.0.1
PORT=3000

# 库目录；compose 里固定为 /data/vault
SDL_VAULT_PATH=./vault

# 对外监听时的访问令牌（长随机字符串）；留空 = 不启用登录
SDL_ACCESS_TOKEN=

# 可选：cookie 派生值的盐
SDL_SESSION_SECRET=
